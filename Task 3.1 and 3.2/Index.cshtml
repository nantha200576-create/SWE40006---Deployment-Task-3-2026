@page
@model IndexModel
@using System.Runtime.InteropServices
@{
    ViewData["Title"] = "SWE40006 - Primary Stack Dashboard";
}

<div class="container my-4">
    <!-- Header Card -->
    <div class="card shadow-sm border-0 mb-4" style="border-top: 5px solid #0078d4 !important;">
        <div class="card-body p-4 text-center">
            <h1 class="display-5 text-primary fw-bold">SWE40006 Task 3.1 & 3.2 - Primary Stack</h1>
            <p class="lead text-dark mb-2"><strong>Student ID:</strong> <strong>106214014</strong></p>
            <div class="alert alert-success fw-bold d-inline-block px-4 py-2 mb-0" role="alert">
                Status: Operational & Deployed to Azure App Service
            </div>
        </div>
    </div>

    <div class="row g-4">
        <!-- System Runtime Info -->
        <div class="col-md-6">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-header bg-primary text-white fw-bold">
                    Host Environment Metrics
                </div>
                <div class="card-body">
                    <ul class="list-group list-group-flush">
                        <li class="list-group-item d-flex justify-content-between align-items-center">
                            <span>Framework:</span>
                            <span class="badge bg-secondary">.NET @Environment.Version</span>
                        </li>
                        <li class="list-group-item d-flex justify-content-between align-items-center">
                            <span>OS Platform:</span>
                            <span class="text-truncate ms-2" style="max-width: 200px;">@RuntimeInformation.OSDescription</span>
                        </li>
                        <li class="list-group-item d-flex justify-content-between align-items-center">
                            <span>Architecture:</span>
                            <span class="badge bg-info text-dark">@RuntimeInformation.OSArchitecture</span>
                        </li>
                        <li class="list-group-item d-flex justify-content-between align-items-center">
                            <span>Environment:</span>
                            <span class="badge bg-success">@(Environment.GetEnvironmentVariable("ASPNETCORE_ENVIRONMENT") ?? "Production")</span>
                        </li>
                    </ul>
                </div>
            </div>
        </div>

        <!-- Azure Deployment Details -->
        <div class="col-md-6">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-header bg-dark text-white fw-bold">
                    Cloud & Application Control
                </div>
                <div class="card-body">
                    <ul class="list-group list-group-flush">
                        <li class="list-group-item d-flex justify-content-between align-items-center">
                            <span>Resource Group:</span>
                            <code>rg-swe40006-106214014</code>
                        </li>
                        <li class="list-group-item d-flex justify-content-between align-items-center">
                            <span>App Service Name:</span>
                            <code>app-csharp-106214014</code>
                        </li>
                        <li class="list-group-item d-flex justify-content-between align-items-center">
                            <span>Pricing Tier:</span>
                            <span class="badge bg-warning text-dark">B1 Basic Plan</span>
                        </li>
                        <li class="list-group-item d-flex justify-content-between align-items-center">
                            <span>Server UTC Time:</span>
                            <span class="fw-bold">@DateTime.UtcNow.ToString("yyyy-MM-dd HH:mm:ss")</span>
                        </li>
                    </ul>
                </div>
            </div>
        </div>
    </div>

    <!-- Secondary Link Callout -->
    <div class="card shadow-sm border-0 mt-4 bg-light">
        <div class="card-body text-center p-3">
            <span class="text-muted">Task 3.3 HD Secondary Stack (PHP 8.2): </span>
            <a href="https://app-php-106214014-bzd8dacjdagbgwfy.eastasia-01.azurewebsites.net" target="_blank" class="fw-bold text-decoration-none">
                View PHP Deployment &rarr;
            </a>
        </div>
    </div>

    <!-- Footer -->
    <div class="text-center mt-4 text-muted small">
        SWE40006 Software Deployment and Evolution &copy; 2026 - Student ID 106214014
    </div>
</div>